{
  "name": "Nancyfi",
  "install": "bash .cursor/dev-install.sh",
  "start": "bash .cursor/dev-start.sh",
  "terminals": [
    {
      "name": "next-dev",
      "command": "export PATH=\"$HOME/.bun/bin:$PATH\" && bun run dev",
      "description": "Next.js dev server on http://localhost:3000"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
