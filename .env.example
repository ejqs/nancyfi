# Database (Railway Postgres — use public TCP proxy host for local dev)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Resend (transactional auth email)
RESEND_API_KEY=re_xxxx
EMAIL_FROM="Nancyfi <noreply@nancyfi.app>"

# Automerge sync server (cross-browser CRDT sync)
# Local: bun run sync  (defaults: port 3030, .data/automerge-sync)
# Production: Railway service `automerge-sync` + NEXT_PUBLIC_AUTOMERGE_SYNC_URL=wss://…
# Auth: shared JWT secret on the web app AND automerge-sync (NAN-33)
AUTOMERGE_SYNC_PORT=3030
AUTOMERGE_SYNC_DATA=.data/automerge-sync
AUTOMERGE_SYNC_JWT_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_AUTOMERGE_SYNC_URL=ws://127.0.0.1:3030
